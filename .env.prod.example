# ============================================================
# Production env-файл для docker-compose.prod.yml.
# Скопируй: cp .env.prod.example .env.prod  и заполни ВСЕ секреты.
# .env.prod НЕ коммитим в git (см. .gitignore).
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=gamemaster
# СГЕНЕРИРУЙ: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD
POSTGRES_DB=gamemaster

# --- Backend ---
# СГЕНЕРИРУЙ: openssl rand -hex 32
# Если оставишь дефолт — backend упадёт на старте (см. core/config.py:_validate_production)
SECRET_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Уровень логов backend (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

# 1 worker по умолчанию (game-state в памяти процесса).
# Увеличивать только если перейдёшь на shared state (Redis).
UVICORN_WORKERS=1

# CORS — публичный домен фронта. CSV или JSON-массив.
CORS_ORIGINS=https://mafia.patgen.ru

# Минимальный уровень логов фронта, который backend принимает в /api/logs/frontend
FRONTEND_LOG_REMOTE_MIN_LEVEL=warning

# --- Frontend (build-time, вшиваются в JS-бандл) ---
# Должны указывать на публичный домен сайта (single-domain архитектура).
REACT_APP_API_BASE_URL=https://mafia.patgen.ru
REACT_APP_WS_BASE_URL=wss://mafia.patgen.ru
REACT_APP_LOG_LEVEL=warn
REACT_APP_REMOTE_LOGS_ENABLED=false
REACT_APP_REMOTE_LOG_MIN_LEVEL=warn
