# syntax=docker/dockerfile:1.7
# ============================================================
# Production build: React (CRA) → nginx:alpine
# CPU в idle ~0%, память ~15 МБ, итоговый образ ~40 МБ.
# ============================================================

# --- Stage 1: build ---
FROM node:20-alpine AS builder
WORKDIR /app

ENV CI=true \
    NODE_ENV=production \
    GENERATE_SOURCEMAP=false \
    DISABLE_ESLINT_PLUGIN=true

# REACT_APP_* переменные CRA «вшивает» в бандл на этапе build,
# поэтому пробрасываем их как build-args (а не runtime env).
# Для прода обязательно задать в .env.prod / docker-compose.prod.yml:
#   REACT_APP_API_BASE_URL=https://mafia.patgen.ru
#   REACT_APP_WS_BASE_URL=wss://mafia.patgen.ru
# (frontend nginx проксирует /api и /ws → backend, т.е. single-domain).
ARG REACT_APP_API_BASE_URL
ARG REACT_APP_WS_BASE_URL
ARG REACT_APP_USE_MOCKS=false
ARG REACT_APP_APP_ENV=production
ARG REACT_APP_LOG_LEVEL=warn
ARG REACT_APP_REMOTE_LOGS_ENABLED=false
ARG REACT_APP_REMOTE_LOG_MIN_LEVEL=warn
ARG REACT_APP_LOG_CAPTURE_CONSOLE=false

ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL} \
    REACT_APP_WS_BASE_URL=${REACT_APP_WS_BASE_URL} \
    REACT_APP_USE_MOCKS=${REACT_APP_USE_MOCKS} \
    REACT_APP_APP_ENV=${REACT_APP_APP_ENV} \
    REACT_APP_LOG_LEVEL=${REACT_APP_LOG_LEVEL} \
    REACT_APP_REMOTE_LOGS_ENABLED=${REACT_APP_REMOTE_LOGS_ENABLED} \
    REACT_APP_REMOTE_LOG_MIN_LEVEL=${REACT_APP_REMOTE_LOG_MIN_LEVEL} \
    REACT_APP_LOG_CAPTURE_CONSOLE=${REACT_APP_LOG_CAPTURE_CONSOLE}

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .
RUN npm run build

# --- Stage 2: runtime (nginx) ---
FROM nginx:1.27-alpine AS runtime

# Удаляем дефолтный конфиг nginx
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранную статику
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

# nginx сам обрабатывает SIGTERM для graceful shutdown
CMD ["nginx", "-g", "daemon off;"]
